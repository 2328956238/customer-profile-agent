# Default mode: deterministic offline mock. No external requests or credentials needed.
PROFILE_MODE=mock
PROFILE_DB=data/profiles.sqlite3

# Optional HTTP tenant isolation. UNSET means unprotected localhost demo mode.
# Set this to a nonempty JSON object mapping operator-owned tenant IDs to unique
# random 32–256 character URL-safe bearer tokens. Invalid/empty values fail startup.
# Generate each token at runtime with secrets.token_urlsafe(32); never commit it.
# PROFILE_AUTH_TOKENS={"demo-shop":"<replace-with-a-random-token>"}
# No .env auto-loading: export configuration in the server process environment.

# Only required after explicitly changing PROFILE_MODE to live.
# Use a Chat Completions compatible endpoint with function calling support.
PROFILE_BASE_URL=
PROFILE_API_KEY=
PROFILE_MODEL=
